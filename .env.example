# ==============================================================================
# PREVCONSULT - EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Para rodar localmente:
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha com as credenciais do seu projeto Supabase (Project Settings > API)
#
# Para Deploy na Vercel:
# Adicione estas mesmas variáveis em:
# Vercel Dashboard > Seu Projeto > Settings > Environment Variables
# ==============================================================================

# SUPABASE - Conexão com Banco de Dados PostgreSQL & Autenticação
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-aqui"
